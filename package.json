{
  "name": "chessed",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:calibration": "cross-env CHESSED_CALIBRATION=1 playwright test e2e/special-calibration.spec.ts",
    "test:accuracy-calibration": "cross-env CHESSED_ACCURACY_CALIBRATION=1 playwright test e2e/accuracy-calibration.spec.ts",
    "test:e2e:perf": "cross-env CHESSED_PERF=1 playwright test e2e/performance.spec.ts",
    "test:e2e:soak": "cross-env CHESSED_SOAK=1 playwright test e2e/confirmation-soak.spec.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-chessboard": "^5.12.1",
    "react-dom": "19.2.8",
    "stockfish": "^18.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.3",
    "cross-env": "^10.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
